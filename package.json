{
  "name": "downloader",
  "productName": "Shabdiz Download Manager",
  "version": "1.4.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format . --write",
    "start": "concurrently \"npm run start:react\" \"npm run start:electron\"",
    "start:react": "cd react && npm run dev",
    "start:electron": "cd electron && npm run start",
    "icon": "electron-icon-builder --input=./assets/icon.png --output=build",
    "icon-flatten": "electron-icon-builder --input=assets/source.png --output=./assets --flatten",
    "sandbox": "cd electron && sudo chown root node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 node_modules/electron/dist/chrome-sandbox",
    "install:node:react": "cd react && npm install",
    "install:node:electron": "cd electron && npm install",
    "install:node:root": "npm install",
    "install:node:all": "npm run install:node:react && npm run install:node:electron && npm run install:node:root",
    "install:node:backend": "npm run install:node:electron && npm run install:node:root",
    "remove:node:all": "npm run remove:node:electron && npm run remove:node:root && npm run remove:node:react",
    "remove:node:electron": "cd electron && rm -rf node_modules package-lock.json",
    "remove:node:backend": "npm run remove:node:electron && npm run remove:node:root",
    "remove:node:react": "cd react && rm -rf node_modules package-lock.json",
    "remove:node:root": "rm -rf node_modules package-lock.json",
    "build": "npm run build:electron && npm run build:react",
    "build:react": "cd react && npm run build",
    "build:electron": "cd electron && npm run build",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:linux:rpm": "npm run build && electron-builder --linux rpm --x64",
    "package:win": "npm run build && electron-builder --win",
    "package:mac:zip": "npm run build && electron-builder --mac=zip",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.yourapp.id",
    "directories": {
      "app": "electron",
      "output": "release",
      "buildResources": "assets"
    },
    "electronLanguages": [
      "en-US",
      "fa"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/.github/**",
      "!**/.vscode/**",
      "!**/.idea/**",
      "!**/*.map",
      "!**/tsconfig.json",
      "!**/tslint.json",
      "!**/.eslintrc*",
      "!**/.prettierrc*"
    ],
    "extraResources": [
      {
        "from": "react/dist",
        "to": "react/dist",
        "filter": [
          "**/*"
        ]
      },
      "./assets/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "electron/src/release-aria2/bin/macOS/",
          "to": "electron/dist/bin/macOS/",
          "filter": [
            "**/*"
          ]
        }
      ],
      "identity": null,
      "icon": "icons"
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "electron/src/release-aria2/bin/win/",
          "to": "electron/dist/bin/win/",
          "filter": [
            "**/*"
          ]
        }
      ],
      "signExts": false,
      "icon": "icons",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Shabdiz download manager",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "linux": {
      "maintainer": "arm131313@gmail.com",
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "icons",
      "category": "Network",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator-gtk3"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "electron": "43.6.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1"
  }
}
